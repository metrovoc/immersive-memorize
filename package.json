{
  "name": "immersive-memorize",
  "version": "0.11.0",
  "private": true,
  "description": "Learn Japanese vocabulary from Netflix and custom subtitles, and export contextual flashcards to Anki",
  "license": "MIT",
  "repository": "github:metrovoc/immersive-memorize",
  "scripts": {
    "dev": "webpack --mode=development --watch",
    "build": "webpack --mode=production",
    "package": "npm run build && cd dist && zip -qr ../immersive-memorize-v$npm_package_version.zip .",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run type-check && npm run lint && npm run format:check && npm test",
    "changelog": "auto-changelog -p",
    "version": "node scripts/sync-version.js && npm run changelog && git add manifest.json CHANGELOG.md"
  },
  "dependencies": {
    "@patdx/kuromoji": "^1.0.4",
    "idb": "^8.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.3.6",
    "@types/node": "^24.0.0",
    "auto-changelog": "^2.7.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.31",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "ts-loader": "^9.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3"
  },
  "auto-changelog": {
    "output": "CHANGELOG.md",
    "template": "keepachangelog",
    "unreleased": true,
    "commitLimit": false,
    "backfillLimit": 3,
    "tagPattern": "v\\d+\\.\\d+\\.\\d+",
    "hideCredit": true
  }
}
